{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kubecon-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "kubecon.getmuyu.com", "custom_domain": true }],
  "observability": { "enabled": true }
}
